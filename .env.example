# Copy to .env (gitignored) and fill in. Never commit real values.
# Render reads these from the service's Environment settings instead.

# Production database (Supabase). Leave unset locally to use the dev Postgres
# described in db/connection.py.
DATABASE_URL=

# Signs login tokens. Must be a long random string in production.
SECRET_KEY=

# Shared secret the router's heartbeat script sends (routers/monitoring.py).
MONITORING_INGEST_TOKEN=

# SMS provider (db/alert_channels.py).
HOSTPINNACLE_API_KEY=
HOSTPINNACLE_USER_ID=
HOSTPINNACLE_PASSWORD=
HOSTPINNACLE_SENDER_ID=

# DeepSeek: the admin assistant (routers/chat.py, db/deepseek.py).
# Without a key the app still runs; the assistant just says it's unavailable.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Assistant limits. The instructions are prompts/assistant.md; CHAT_SYSTEM_PROMPT,
# if set, replaces that file (leave unset to use it).
CHAT_SYSTEM_PROMPT=
CHAT_MAX_MESSAGES=20
CHAT_MAX_CHARS=4000
CHAT_MAX_TOOL_ROUNDS=4
CHAT_TIMEOUT_SECONDS=30
CHAT_RATE_LIMIT_PER_MINUTE=20

# How often an open Revenue page re-reads its figures.
REVENUE_POLL_SECONDS=30

# Network page (CCR2116). One ingest token per router, named after its slug;
# make one with: python tools/render_router_script.py --new-token
NETWORK_INGEST_TOKEN_CCR2116=
# Only for tools/render_router_script.py on your own computer (not Render):
# the Ops address the router posts to.
NETWORK_INGEST_URL=https://YOUR-APP.onrender.com
# Status thresholds (defaults shown).
NETWORK_NOT_REPORTING_SECONDS=60
NETWORK_UTILIZATION_AMBER_PCT=80
NETWORK_CPU_AMBER_PCT=80
NETWORK_GATEWAY_LOSS_AMBER_PCT=20
NETWORK_GATEWAY_RTT_AMBER_MS=50

# SmartOLT (Phase 6). A dedicated key for OPS, made in SmartOLT under
# Settings > General > API KEY. Read-only use until 6C.
SMARTOLT_URL=https://jasiri.smartolt.com
SMARTOLT_API_KEY=
# Authorizing ONUs from OPS. On unless set to false (the kill switch).
SMARTOLT_WRITES_ENABLED=true
# One switch per ONU action (6C); each is on unless set to false.
SMARTOLT_ACTION_REBOOT=true
SMARTOLT_ACTION_DISABLE=true
SMARTOLT_ACTION_ENABLE=true
# 6D configuration changes, each on unless set to false: resync config,
# speed profiles, Ethernet port modes, location details, attached VLANs,
# ONU mode (WAN VLAN, Routing/Bridging, WAN mode, remote access), delete.
SMARTOLT_ACTION_RESYNC=true
SMARTOLT_ACTION_SPEED=true
SMARTOLT_ACTION_PORTS=true
SMARTOLT_ACTION_LOCATION=true
SMARTOLT_ACTION_VLANS=true
SMARTOLT_ACTION_MODE=true
SMARTOLT_ACTION_DELETE=true
# Webhooks: the "Signing secret" (whsec_...) from SmartOLT's API key > Edit >
# Webhook. Empty = OPS refuses every webhook. Webhook URL to give SmartOLT:
# https://YOUR-APP.onrender.com/smartolt/webhook
SMARTOLT_WEBHOOK_SECRET=
# LOS alerts for ONUs (customers and hotspot sites). On unless set to false.
ONU_LOS_ALERTS_ENABLED=true
