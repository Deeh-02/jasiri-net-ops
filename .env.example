# Copy to .env (gitignored) and fill in. Never commit real values.
# Render reads these from the service's Environment settings instead.

# Production database (Supabase). Leave unset locally to use the dev Postgres
# described in db/connection.py.
DATABASE_URL=

# Signs login tokens. Must be a long random string in production.
SECRET_KEY=

# Shared secret the router's heartbeat script sends (routers/monitoring.py).
MONITORING_INGEST_TOKEN=

# SMS provider (db/alert_channels.py).
HOSTPINNACLE_API_KEY=
HOSTPINNACLE_USER_ID=
HOSTPINNACLE_PASSWORD=
HOSTPINNACLE_SENDER_ID=

# DeepSeek: the Revenue Report's AI analysis panel (db/deepseek.py).
# Without a key the app still runs; the panel just says "Insights unavailable".
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Seconds between AI analysis regenerations for the same view (only when the
# figures have also changed), and how long to wait for DeepSeek.
INSIGHTS_MIN_INTERVAL_SECONDS=600
INSIGHTS_TIMEOUT_SECONDS=30

# How often an open Revenue page re-reads its figures.
REVENUE_POLL_SECONDS=30
